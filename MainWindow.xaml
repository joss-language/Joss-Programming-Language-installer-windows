<Window
    x:Class="Joss_Programming_Language_installer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Joss Programming Language - Setup">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- 0: Barra de título integrada -->
            <RowDefinition Height="42"/>
            <!-- 1: Contenido central con ScrollViewer -->
            <RowDefinition Height="*"/>
            <!-- 2: Barra inferior de acciones -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de título integrada -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="JosSecurity Action Setup" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- ScrollViewer que evita que se corte el contenido -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="28,8,28,16">

                <!-- PANEL 1: SELECCIÓN Y CONFIGURACIÓN -->
                <StackPanel x:Name="OptionsPanel" Spacing="16" Visibility="Visible">
                    <!-- Encabezado dinámico -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TxtHeaderTitle" Text="JosSecurity Manager" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtHeaderDesc" Text="Selecciona una acción para administrar el entorno de Joss." 
                                   Style="{StaticResource BodyTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Tarjeta 1: Selector de Modo / Acción -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Acción a realizar" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <ComboBox x:Name="CmbAction" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CmbAction_SelectionChanged">
                                <ComboBoxItem Tag="Install">Instalar (Joss Runtime + Extensión VS Code)</ComboBoxItem>
                                <ComboBoxItem Tag="Update">Actualizar (Solo si existe nueva versión)</ComboBoxItem>
                                <ComboBoxItem Tag="Reinstall">Reinstalar (Descarga y reconfigura la última versión)</ComboBoxItem>
                                <ComboBoxItem Tag="Uninstall">Desinstalar (Remover Runtime, PATH y Extensión)</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta 2: Ruta de instalación (Oculta en modo Desinstalar) -->
                    <Border x:Name="CardPath" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Ubicación de instalación" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <TextBox x:Name="TxtInstallPath" 
                                         Text="C:\Users\Asus\AppData\Local\Programs\Joss" 
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Click="BtnBrowse_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xED25;" FontSize="14"/>
                                        <TextBlock Text="Examinar"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta 3: Opciones de componentes -->
                    <Border x:Name="CardOptions" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Opciones adicionales" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                            <CheckBox x:Name="ChkAddToPath" IsChecked="True">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Configurar variable de entorno PATH" Style="{StaticResource BodyTextBlockStyle}"/>
                                    <TextBlock x:Name="TxtPathSub" Text="Permite ejecutar 'joss' directamente desde cualquier terminal." 
                                               Style="{StaticResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </CheckBox>

                            <MenuFlyoutSeparator Margin="0,4"/>

                            <CheckBox x:Name="ChkInstallVSCode" IsChecked="True">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="TxtVsCodeTitle" Text="Extensión para Visual Studio Code" Style="{StaticResource BodyTextBlockStyle}"/>
                                    <TextBlock x:Name="TxtVsCodeSub" Text="Instala el paquete oficial de soporte de sintaxis y LSP." 
                                               Style="{StaticResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- PANEL 2: PROGRESO DE ACCIÓN -->
                <StackPanel x:Name="ProgressPanel" Spacing="16" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,20,0,0">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon x:Name="IconStatus" Glyph="&#xE896;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="TxtStatus" Text="Procesando..." Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtDetail" Text="Iniciando tarea..." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ProgressBar x:Name="ProgressBarInstall" IsIndeterminate="True" Height="6" CornerRadius="3" MaxWidth="520"/>

                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12" MaxWidth="520">
                        <ScrollViewer Height="110" x:Name="LogScroller">
                            <TextBlock x:Name="TxtConsoleLog" 
                                       FontFamily="Cascadia Mono, Consolas, Courier New" 
                                       FontSize="11" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Barra inferior de acciones -->
        <Border Grid.Row="2" 
                Background="{ThemeResource LayerFillColorAltBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="28,14">
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                <Button x:Name="BtnCancel" Grid.Column="1" Content="Salir" Width="90" Click="BtnCancel_Click"/>
                <Button x:Name="BtnAction" Grid.Column="2" Content="Continuar" Width="120" 
                        Style="{StaticResource AccentButtonStyle}" Click="BtnAction_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>